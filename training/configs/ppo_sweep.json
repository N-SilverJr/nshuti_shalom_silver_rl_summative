{
  "algo": "ppo",
  "base": {
    "seed": 0,
    "total_frames": 300000,
    "eval_every": 15000,
    "eval_episodes": 20,
    "final_eval_episodes": 50,
    "hidden": [
      64,
      64
    ],
    "activation": "tanh",
    "num_envs": 4,
    "lr": 0.0003,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_epsilon": 0.2,
    "entropy_coef": 0.01,
    "value_coef": 0.5,
    "n_epochs": 4,
    "frames_per_batch": 2048,
    "minibatch_size": 256,
    "normalize_advantage": true,
    "max_grad_norm": 0.5,
    "lr_anneal": false
  },
  "runs": [
    {
      "name": "r01_baseline"
    },
    {
      "name": "r02_lr_high",
      "lr": 0.001
    },
    {
      "name": "r03_lr_low",
      "lr": 0.0001
    },
    {
      "name": "r04_clip_01",
      "clip_epsilon": 0.1
    },
    {
      "name": "r05_clip_03",
      "clip_epsilon": 0.3
    },
    {
      "name": "r06_no_entropy",
      "entropy_coef": 0.0
    },
    {
      "name": "r07_high_entropy",
      "entropy_coef": 0.05
    },
    {
      "name": "r08_epochs_10",
      "n_epochs": 10
    },
    {
      "name": "r09_lambda_08",
      "gae_lambda": 0.8
    },
    {
      "name": "r10_small_rollout",
      "frames_per_batch": 512,
      "minibatch_size": 64
    }
  ]
}